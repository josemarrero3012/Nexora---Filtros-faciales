<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nexora.Tests
    ============
    Pruebas automáticas (xUnit) de la lógica de Nexora.Core: gestos, zona
    muerta, colocación de los filtros y órdenes de voz.

    Ninguna prueba abre la cámara ni el micrófono: solo comprueban las cuentas.
    Se lanzan desde el Explorador de pruebas de Visual Studio, desde la ventana
    "Unit Tests" de Rider o con "dotnet test" en la terminal.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexora.Core\Nexora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
