<!--
    MainWindow.xaml
    ===============
    La única ventana de Nexora. Sigue la idea del mando multimodal de clase:

      - A la izquierda, la imagen de la cámara y debajo los números de rendimiento.
      - A la derecha, un interruptor por módulo, el filtro elegido, la última
        orden de voz, los ajustes del detector y el historial de eventos.

    Aquí no hay lógica: todo son Binding al MainViewModel (MVVM).

    [Ampliación con uso de IA] Rediseño visual (ver docs/Uso-de-IA.md y los
    comentarios de App.xaml). Los Binding son EXACTAMENTE los mismos que antes
    (más uno nuevo, FiltroRealista); solo cambia cómo se ve:
      - La cámara es un visor con marcas en las esquinas, como el de una cámara de fotos.
      - Las medidas van en una sola barra debajo del visor, con números grandes.
      - El panel derecho es una sola columna con líneas finas, no tarjetas sueltas.
      - Los filtros se eligen viendo su dibujo, no solo el nombre.
-->
<Window x:Class="Nexora.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nexora.App.ViewModels"
        xmlns:modelos="clr-namespace:Nexora.Core.Modelos;assembly=Nexora.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Nexora"
        Width="1360" Height="880" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoBrush}"
        Foreground="{StaticResource TintaBrush}"
        FontFamily="{StaticResource LetraTexto}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Izquierda: cámara y medidas ===================== -->
        <Grid Grid.Column="0" Margin="28,22,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecera: nombre y estado de la cámara -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Nexora" FontFamily="{StaticResource LetraTitulos}" FontSize="30"
                               FontWeight="SemiBold" VerticalAlignment="Bottom" />
                    <TextBlock Text="Manejar el ordenador con la mano, la cara y la voz" FontSize="13"
                               Foreground="{StaticResource TintaSuaveBrush}"
                               VerticalAlignment="Bottom" Margin="14,0,0,6" />
                </StackPanel>

                <!-- Piloto de la cámara: rojo "grabando" cuando hay imagen, gris si no -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource LineaBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CamaraFuncionando}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DirectoBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding EstadoCamara}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Visor de la cámara -->
            <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding ImagenCamara}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />

                    <!-- Marcas de las esquinas, como en el visor de una cámara -->
                    <Grid Margin="16" IsHitTestVisible="False">
                        <Grid.Resources>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 0 22 L 0 0 L 22 0" />
                                <Setter Property="Stroke" Value="{StaticResource SobreVideoBrush}" />
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Style>
                        </Grid.Resources>
                        <Path HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                        </Path>
                        <Path HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
                        </Path>
                        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
                        </Path>
                    </Grid>

                    <!-- Mensaje mientras no llega ninguna imagen -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CamaraFuncionando}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding EstadoCamara}" FontFamily="{StaticResource LetraTitulos}" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Si otra aplicación está usando la webcam, ciérrala y vuelve a abrirla aquí."
                                   FontSize="13" Foreground="#B3FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <Button Content="Volver a abrir la cámara" Command="{Binding ReiniciarCamaraCommand}"
                                Style="{StaticResource BotonSobreVideo}" Margin="0,18,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Aviso cuando el programa pregunta antes de salir -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,22,0,0"
                            Background="{StaticResource VozBrush}" CornerRadius="4" Padding="16,9">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsperandoConfirmacion}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="¿Seguro que quieres salir? Di «sí» o «no»" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Barra de medidas: lo que vamos a medir en las pruebas -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <!-- Cada medida con una línea fina a la izquierda que la separa de la anterior -->
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource LineaBrush}" />
                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                        <Setter Property="Padding" Value="16,0,8,0" />
                    </Style>
                </Grid.Resources>

                <Border Grid.Column="0" BorderThickness="0" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Gesto" Style="{StaticResource EtiquetaMedida}" />
                        <TextBlock Text="{Binding GestoActual}" Style="{StaticResource ValorMedida}"
                                   Foreground="{StaticResource ManoBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Imágenes por segundo" Style="{StaticResource EtiquetaMedida}" />
                        <TextBlock Text="{Binding Fps}" Style="{StaticResource ValorMedida}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Proceso por imagen" Style="{StaticResource EtiquetaMedida}" />
                        <TextBlock Text="{Binding MsPorImagen}" Style="{StaticResource ValorMedida}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="Respuesta del gesto" Style="{StaticResource EtiquetaMedida}" />
                        <TextBlock Text="{Binding RespuestaGesto}" Style="{StaticResource ValorMedida}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4">
                    <StackPanel>
                        <TextBlock Text="Respuesta de la voz" Style="{StaticResource EtiquetaMedida}" />
                        <TextBlock Text="{Binding RespuestaVoz}" Style="{StaticResource ValorMedida}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== Derecha: controles e historial ===================== -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineaBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MaxHeight="560" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Módulos: un interruptor por cada uno, con el color de su módulo -->
                        <Border Style="{StaticResource Seccion}">
                            <StackPanel>
                                <TextBlock Text="Módulos" Style="{StaticResource TituloSeccion}" />

                                <CheckBox Style="{StaticResource Interruptor}" Tag="{StaticResource CaraBrush}"
                                          IsChecked="{Binding FiltrosActivos}">
                                    <StackPanel>
                                        <TextBlock Text="Filtros faciales" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Busca la cara y los ojos con Haar Cascade" Style="{StaticResource TextoSuave}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Interruptor}" Tag="{StaticResource ManoBrush}"
                                          IsChecked="{Binding ControlGestualActivo}">
                                    <StackPanel>
                                        <TextBlock Text="Control gestual" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Mueve el ratón de verdad. Cierra el puño para pausar." Style="{StaticResource TextoSuave}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Interruptor}" Tag="{StaticResource VozBrush}"
                                          IsChecked="{Binding VozActiva}">
                                    <StackPanel>
                                        <TextBlock Text="Órdenes de voz" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Escucha las órdenes en español" Style="{StaticResource TextoSuave}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Interruptor}" Tag="{StaticResource CaraBrush}"
                                          IsChecked="{Binding ModoCabeza}">
                                    <StackPanel>
                                        <TextBlock Text="Plan B: cursor con la cabeza" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Zona muerta como en clase; el clic se hace diciendo «clic»" Style="{StaticResource TextoSuave}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding MostrarAyudas}">
                                    <StackPanel>
                                        <TextBlock Text="Mostrar ayudas en la imagen" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Recuadros, ojos y puntos de la mano" Style="{StaticResource TextoSuave}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Filtro elegido -->
                        <Border Style="{StaticResource Seccion}">
                            <StackPanel>
                                <TextBlock Text="Filtro" Style="{StaticResource TituloSeccion}" />
                                <ListBox ItemsSource="{Binding Filtros}"
                                         SelectedValuePath="Tipo"
                                         SelectedValue="{Binding FiltroSeleccionado}"
                                         ItemContainerStyle="{StaticResource BaldosaFiltro}"
                                         Background="Transparent" BorderThickness="0" Margin="0,0,-8,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <!-- [IA] Para comparar el filtro "tal cual" con el nuevo en las pruebas -->
                                <CheckBox Style="{StaticResource Interruptor}" Tag="{StaticResource CaraBrush}"
                                          IsChecked="{Binding FiltroRealista}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Filtro realista" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Sombra suave, se adapta a la luz y no parpadea si se pierde la cara un momento"
                                                   Style="{StaticResource TextoSuave}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Última orden de voz -->
                        <Border Style="{StaticResource Seccion}">
                            <StackPanel>
                                <TextBlock Text="Voz" Style="{StaticResource TituloSeccion}" />
                                <Border BorderBrush="{StaticResource VozBrush}" BorderThickness="3,0,0,0" Padding="12,2,0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UltimaOrdenVoz}" FontFamily="{StaticResource LetraTitulos}"
                                                   FontSize="20" Foreground="{StaticResource TintaBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetalleUltimaOrden}" Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource TextoSuave}" Margin="0,12,0,0" LineHeight="18">
                                    <Run Text="Puedes decir " /><Run Text="{Binding FrasesDisponibles, Mode=OneWay}" Foreground="{StaticResource TintaBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Ajustes del detector: para probar valores y elegirlos con datos -->
                        <Border Style="{StaticResource Seccion}">
                            <Expander Style="{StaticResource Desplegable}">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="Ajustes para las pruebas" Style="{StaticResource TituloSeccion}" Margin="0" />
                                        <TextBlock Text="Cambia los valores en marcha y compara los resultados" Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                        <Run Text="Factor de escala de la cara: " /><Run Text="{Binding FactorEscalaCara, StringFormat=0.00, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="1.05" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding FactorEscalaCara}" />

                                    <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                        <Run Text="Vecinos mínimos: " /><Run Text="{Binding VecinosMinimosCara, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding VecinosMinimosCara}" />

                                    <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                        <Run Text="Confianza mínima de la voz: " /><Run Text="{Binding ConfianzaMinimaVoz, StringFormat=P0, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="0.3" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding ConfianzaMinimaVoz}" />

                                    <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                        <Run Text="Zona muerta del cursor: " /><Run Text="{Binding ZonaMuertaPx, StringFormat='{}{0:0} px', Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding ZonaMuertaPx}" />

                                    <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                        <Run Text="Suavizado del cursor: " /><Run Text="{Binding SuavizadoCursor, StringFormat=0.00, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding SuavizadoCursor}" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Historial de eventos: hora, origen (mano, cara o voz) y acción -->
                <Grid Grid.Row="1" Margin="22,18,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,12,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Exportar CSV" Command="{Binding ExportarHistorialCommand}"
                                    Style="{StaticResource BotonPlano}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Limpiar" Command="{Binding LimpiarHistorialCommand}"
                                    Style="{StaticResource BotonPlano}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="Historial" Style="{StaticResource TituloSeccion}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Historial}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,4,10,4" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type modelos:EventoNexora}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HoraTexto}" FontFamily="{StaticResource LetraTitulos}" FontSize="12"
                                               Foreground="{StaticResource TintaSuaveBrush}" VerticalAlignment="Top" />

                                    <!-- Origen: un cuadradito y el nombre, con el color de su módulo -->
                                    <StackPanel x:Name="Origen" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Rectangle x:Name="Marca" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Fill="{StaticResource TintaSuaveBrush}" />
                                        <TextBlock x:Name="NombreOrigen" Text="{Binding Origen}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TintaSuaveBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Accion}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TintaBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Origen}" Value="{x:Static modelos:OrigenEvento.Mano}">
                                        <Setter TargetName="Marca" Property="Fill" Value="{StaticResource ManoBrush}" />
                                        <Setter TargetName="NombreOrigen" Property="Foreground" Value="{StaticResource ManoBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Origen}" Value="{x:Static modelos:OrigenEvento.Cara}">
                                        <Setter TargetName="Marca" Property="Fill" Value="{StaticResource CaraBrush}" />
                                        <Setter TargetName="NombreOrigen" Property="Foreground" Value="{StaticResource CaraBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Origen}" Value="{x:Static modelos:OrigenEvento.Voz}">
                                        <Setter TargetName="Marca" Property="Fill" Value="{StaticResource VozBrush}" />
                                        <Setter TargetName="NombreOrigen" Property="Foreground" Value="{StaticResource VozBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
