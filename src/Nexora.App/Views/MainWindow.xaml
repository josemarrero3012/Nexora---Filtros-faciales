<!--
    MainWindow.xaml
    ===============
    La única ventana de Nexora. Sigue la idea del mando multimodal de clase:

      - A la izquierda, la imagen de la cámara y debajo los números de rendimiento.
      - A la derecha, un interruptor por módulo, el filtro elegido, la última
        orden de voz, los ajustes del detector y el historial de eventos.

    Aquí no hay lógica: todo son Binding al MainViewModel (MVVM).
-->
<Window x:Class="Nexora.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nexora.App.ViewModels"
        xmlns:modelos="clr-namespace:Nexora.Core.Modelos;assembly=Nexora.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Nexora · Visión artificial y voz"
        Width="1360" Height="860" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoBrush}"
        Foreground="{StaticResource TextoBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Cabecera ===================== -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Nexora" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="  ·  manos, cara y voz para manejar el ordenador" FontSize="14"
                           Foreground="{StaticResource TextoSuaveBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>

            <!-- Estado de la cámara (punto verde o rojo) -->
            <Border HorizontalAlignment="Right" CornerRadius="12" Padding="10,4"
                    Background="{StaticResource TarjetaBrush}" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource RojoBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CamaraFuncionando}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource VerdeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding EstadoCamara}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Columna izquierda: cámara ===================== -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Imagen de la cámara -->
            <Border Grid.Row="0" Background="Black" CornerRadius="12" ClipToBounds="True"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding ImagenCamara}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />

                    <!-- Mensaje mientras no llega ninguna imagen -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CamaraFuncionando}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding EstadoCamara}" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextoSuaveBrush}" />
                        <Button Content="Volver a abrir la cámara" Command="{Binding ReiniciarCamaraCommand}"
                                Style="{StaticResource BotonPlano}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Aviso grande cuando el programa pregunta antes de salir -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Background="{StaticResource AmbarBrush}" CornerRadius="8" Padding="14,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsperandoConfirmacion}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="¿Seguro que quieres salir? Di «sí» o «no»" FontWeight="SemiBold"
                                   Foreground="{StaticResource FondoBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Rendimiento: lo que vamos a medir en las pruebas -->
            <UniformGrid Grid.Row="1" Columns="5" Margin="0,12,0,0">
                <UniformGrid.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                        <Setter Property="Margin" Value="0,0,10,0" />
                        <Setter Property="Padding" Value="12,8" />
                    </Style>
                </UniformGrid.Resources>
                <Border>
                    <StackPanel>
                        <TextBlock Text="GESTO" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding GestoActual}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource AcentoBrush}" />
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="FLUIDEZ (FPS)" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Fps}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="PROCESO POR IMAGEN" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding MsPorImagen}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="RESPUESTA GESTO" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding RespuestaGesto}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0">
                    <StackPanel>
                        <TextBlock Text="RESPUESTA VOZ" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding RespuestaVoz}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- ===================== Columna derecha: controles e historial ===================== -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel>

                    <!-- Módulos: un interruptor por cada uno -->
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="MÓDULOS" Style="{StaticResource TituloTarjeta}" />

                            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding FiltrosActivos}">
                                <StackPanel>
                                    <TextBlock Text="Filtros faciales" FontWeight="SemiBold" />
                                    <TextBlock Text="Cara y ojos con Haar Cascade" Style="{StaticResource TextoSuave}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding ControlGestualActivo}">
                                <StackPanel>
                                    <TextBlock Text="Control gestual" FontWeight="SemiBold" />
                                    <TextBlock Text="Mueve el ratón de verdad (puño = pausa)" Style="{StaticResource TextoSuave}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding VozActiva}">
                                <StackPanel>
                                    <TextBlock Text="Órdenes de voz" FontWeight="SemiBold" />
                                    <TextBlock Text="System.Speech en español" Style="{StaticResource TextoSuave}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding ModoCabeza}">
                                <StackPanel>
                                    <TextBlock Text="Plan B: cursor con la cabeza" FontWeight="SemiBold" />
                                    <TextBlock Text="Zona muerta como en clase y clic diciendo «clic»" Style="{StaticResource TextoSuave}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding MostrarAyudas}">
                                <StackPanel>
                                    <TextBlock Text="Mostrar ayudas" FontWeight="SemiBold" />
                                    <TextBlock Text="Recuadros, ojos y puntos de la mano" Style="{StaticResource TextoSuave}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Filtro elegido -->
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="FILTRO" Style="{StaticResource TituloTarjeta}" />
                            <ListBox ItemsSource="{Binding Filtros}"
                                     SelectedValuePath="Tipo"
                                     SelectedValue="{Binding FiltroSeleccionado}"
                                     ItemContainerStyle="{StaticResource PastillaFiltro}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Última orden de voz -->
                    <Border Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="ÚLTIMA ORDEN DE VOZ" Style="{StaticResource TituloTarjeta}" />
                            <TextBlock Text="{Binding UltimaOrdenVoz}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource AmbarBrush}" />
                            <TextBlock Text="{Binding DetalleUltimaOrden}" Style="{StaticResource TextoSuave}" Margin="0,2,0,8" />
                            <TextBlock Text="{Binding FrasesDisponibles}" Style="{StaticResource TextoSuave}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Ajustes del detector: para probar valores y elegirlos con datos -->
                    <Border Style="{StaticResource Tarjeta}">
                        <Expander Foreground="{StaticResource TextoBrush}">
                            <Expander.Header>
                                <TextBlock Text="AJUSTES PARA LAS PRUEBAS" Style="{StaticResource TituloTarjeta}" Margin="0" />
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                    <Run Text="Factor de escala de la cara: " /><Run Text="{Binding FactorEscalaCara, StringFormat=0.00, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Slider Minimum="1.05" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding FactorEscalaCara}" />

                                <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                    <Run Text="Vecinos mínimos: " /><Run Text="{Binding VecinosMinimosCara, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding VecinosMinimosCara}" />

                                <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                    <Run Text="Confianza mínima de la voz: " /><Run Text="{Binding ConfianzaMinimaVoz, StringFormat=P0, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Slider Minimum="0.3" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding ConfianzaMinimaVoz}" />

                                <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                    <Run Text="Zona muerta del cursor: " /><Run Text="{Binding ZonaMuertaPx, StringFormat='{}{0:0} px', Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding ZonaMuertaPx}" />

                                <TextBlock Style="{StaticResource EtiquetaAjuste}">
                                    <Run Text="Suavizado del cursor: " /><Run Text="{Binding SuavizadoCursor, StringFormat=0.00, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Slider Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding SuavizadoCursor}" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Historial de eventos: hora, origen (mano, cara o voz) y acción -->
            <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Exportar CSV" Command="{Binding ExportarHistorialCommand}"
                                    Style="{StaticResource BotonPlano}" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Limpiar" Command="{Binding LimpiarHistorialCommand}"
                                    Style="{StaticResource BotonPlano}" Padding="8,3" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="HISTORIAL" Style="{StaticResource TituloTarjeta}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Historial}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,3" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type modelos:EventoNexora}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HoraTexto}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource TextoSuaveBrush}" VerticalAlignment="Top" />

                                    <!-- Etiqueta de color según el origen -->
                                    <Border Grid.Column="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BordeBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Origen}" Value="{x:Static modelos:OrigenEvento.Mano}">
                                                        <Setter Property="Background" Value="{StaticResource AcentoBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Origen}" Value="{x:Static modelos:OrigenEvento.Cara}">
                                                        <Setter Property="Background" Value="{StaticResource MoradoBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Origen}" Value="{x:Static modelos:OrigenEvento.Voz}">
                                                        <Setter Property="Background" Value="{StaticResource AmbarBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Origen}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FondoBrush}" />
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Accion}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextoBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
